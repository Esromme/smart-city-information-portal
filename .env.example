# Copy to .env and fill in your own values. Never commit real values.
# Server-side variables live here. Client (Vite) variables live in
# client/.env.local — see client/.env.example.

# Required: PostgreSQL connection string (Supabase pooler works).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# API port.
PORT=5000

# Required for administrator sign-in and every protected write endpoint.
# Without these, public reads still work but all writes return 503.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Comma-separated allowlist. Only these confirmed accounts can administer content.
ADMIN_EMAILS=admin@example.com

# Optional server settings
# PG_POOL_MAX=5
# CORS_ORIGINS=http://localhost:5173,https://your-domain.example
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# TRUST_PROXY=1

# Optional weather settings (Open-Meteo, no API key; non-commercial free tier).
# WEATHER_ENABLED=true
# WEATHER_LAT=11.0849
# WEATHER_LON=39.7392
# WEATHER_CACHE_SECONDS=600
# WEATHER_TIMEOUT_MS=8000
