{
  "name": "kombolcha-smart-city",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Smart City Information Portal - announcements, services and city map",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "vitest run",
    "test:client": "npm --prefix client test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "vitest": "^4.1.12"
  }
}
