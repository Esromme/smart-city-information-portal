# Copy to client/.env.local and fill in your own values.
# This file is read by Vite at build and dev time. Never commit real values.
#
# These must match the server-side Supabase project (root .env) so that the
# token the browser obtains is the token the API verifies.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Optional: API base URL. Defaults to /api, which the Vite dev proxy forwards
# to http://localhost:5000. Set an absolute URL only if the API is elsewhere.
# VITE_API_URL=/api

# Optional: MapTiler basemap (Free plan). Without a key the map falls back to
# the OpenStreetMap public tiles, so the portal keeps working.
#
# 1. Create a key at https://cloud.maptiler.com/account/keys
# 2. Restrict it to your HTTP origins (e.g. localhost + your production domain).
#    MapTiler web keys are publishable; the origin allowlist is what protects them.
# 3. Paste it below. It is baked into the built bundle, so the origin allowlist
#    matters — never commit a real key to source control.
# VITE_MAPTILER_KEY=YOUR-MAPTILER-KEY
# Optional style overrides (light and dark variants).
# VITE_MAPTILER_STYLE=streets-v4
# VITE_MAPTILER_STYLE_DARK=streets-v4-dark
